DATABASE_URL=postgresql://user:password@host:5432/wilkerson_sovereign
GATEWAY_API_TOKEN=replace-with-a-long-random-secret
# Optional secret JSON: {"research-agent":{"token":"long-random-token","scope":["provider:wilkerson","operation:gateway.verify","operation:concierge.inspect"]}}
WILKERSON_AGENT_TOKENS_JSON=
WORKER_POLL_MS=750
WORKER_LEASE_SECONDS=90
EXECUTION_SELF_TEST_ON_BOOT=false
INJECTION_KILL_THRESHOLD=6
INJECTION_WINDOW_SECONDS=600

# Exact outbound hosts are comma-separated. Private and HTTP destinations remain blocked
# unless separately and explicitly authorized here by the server operator.
WILKERSON_APPROVED_DESTINATIONS=
WILKERSON_PRIVATE_DESTINATIONS=
WILKERSON_HTTP_DESTINATIONS=

# Provider adapters remain configuration_required until every required value is set.
ORGO_API_KEY=
ORGO_WORKSPACE_ID=
OPENCLAW_GATEWAY_URL=
OPENCLAW_TOKEN=
HERMES_BASE_URL=
HERMES_API_KEY=
VAGON_API_KEY=
VAGON_API_SECRET=
VAGON_APPLICATION_ID=
VAGON_STREAM_ID=
HIGHLEVEL_TOKEN=
HIGHLEVEL_LOCATION_ID=
GITHUB_TOKEN=
GITHUB_OWNER=
RENDER_API_KEY=
RENDER_WORKSPACE_ID=
